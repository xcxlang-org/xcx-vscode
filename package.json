{
    "name": "xcx-vscode",
    "displayName": "XCX Language Support",
    "description": "Rich language support for XCX 4.4 — syntax highlighting, hover documentation, outline, snippets, diagnostics.",
    "version": "4.4.0",
    "publisher": "xcxlang-org",
    "repository": {
        "type": "git",
        "url": "https://github.com/xcxlang-org/xcx-vscode"
    },
    "license": "Apache-2.0",
    "homepage": "https://github.com/xcxlang-org/xcx-vscode#readme",
    "bugs": {
        "url": "https://github.com/xcxlang-org/xcx-vscode/issues"
    },
    "icon": "images/icon.png",
    "engines": {
        "vscode": "^1.44.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets",
        "Linters"
    ],
    "keywords": [
        "xcx",
        "xcx4",
        "xcx4.4",
        "programming language",
        "fiber",
        "coroutine",
        "pax",
        "perf",
        "database",
        "sqlite"
    ],
    "activationEvents": [
        "onLanguage:xcx",
        "onLanguage:pax"
    ],
    "main": "./extension.js",
    "contributes": {
        "configuration": {
            "title": "XCX",
            "properties": {
                "xcx.linter.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable real-time XCX diagnostics (missing semicolons, missing then;/do;, unclosed <<< blocks, malformed yield from)."
                }
            }
        },
        "languages": [
            {
                "id": "xcx",
                "aliases": [
                    "XCX",
                    "xcx"
                ],
                "extensions": [
                    ".xcx"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "images/icon.png",
                    "dark": "images/icon.png"
                }
            },
            {
                "id": "pax",
                "aliases": [
                    "PAX",
                    "pax"
                ],
                "extensions": [
                    ".pax"
                ],
                "configuration": "./pax-configuration.json",
                "icon": {
                    "light": "images/paxLogo.png",
                    "dark": "images/paxLogo.png"
                }
            }
        ],
        "grammars": [
            {
                "language": "xcx",
                "scopeName": "source.xcx",
                "path": "./syntaxes/xcx.tmLanguage.json"
            },
            {
                "language": "pax",
                "scopeName": "source.pax",
                "path": "./syntaxes/pax.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "xcx",
                "path": "./snippets/snippets.json"
            },
            {
                "language": "pax",
                "path": "./snippets/snippets.json"
            }
        ],
        "iconThemes": [
            {
                "id": "xcx-icon-theme",
                "label": "XCX File Icons",
                "path": "./fileicons/theme.json"
            }
        ]
    },
    "scripts": {
        "package": "vsce package"
    },
    "devDependencies": {
        "@vscode/vsce": "^2.19.0",
        "ovsx": "^1.1.1"
    }
}